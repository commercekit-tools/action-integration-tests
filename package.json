{
  "name": "@commercekit-tools/action-integration-tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Guarded cross-repository Sandbox integration tests for CommerceKit Actions.",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "policy": "node scripts/check-policy.mjs",
    "scan:public": "node scripts/scan-public.mjs",
    "audit": "pnpm audit --audit-level=high",
    "quality": "pnpm format:check && pnpm lint && pnpm test && pnpm policy && pnpm scan:public && pnpm audit"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@commercekit-tools/ccv2-client": "0.0.3",
    "@commercekit-tools/notification-contract": "0.0.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "yaml": "2.9.1"
  }
}
